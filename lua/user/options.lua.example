-- Copy to lua/user/options.lua (or run :LokiEdit options). Loaded right after
-- config/options.lua, so anything you set here wins. Gitignored: your changes
-- never conflict on update. NOT in git means NOT backed up: run :LokiBackup.

-- Turn the arrow-key ban off:
-- vim.g.loki_disable_arrows = false

-- Name your own <leader> prefixes (shown in which-key and the cheatsheet):
-- vim.g.loki_leader_groups = { g = "Git", o = "Notes" }

-- Hide the one-time welcome notice shown when the config was cloned by hand:
-- vim.g.loki_hide_notices = true

-- Indent is 4 spaces in every filetype by default. To change it:
-- vim.opt.shiftwidth = 2
-- vim.opt.tabstop = 2
-- vim.opt.softtabstop = 2
-- ...or let each filetype plugin pick its own (2 for Lua, YAML, ...):
-- vim.g.loki_ftplugin_indent = true

-- Brackets are coloured by nesting depth; turn that off:
-- vim.g.loki_rainbow_brackets = false

-- vim.opt.wrap = true
