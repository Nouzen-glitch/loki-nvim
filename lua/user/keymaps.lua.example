-- Copy to lua/user/keymaps.lua (or run :LokiEdit keymaps). Loaded right after
-- config/keymaps.lua, so a mapping here replaces a default with the same key.
-- Always give it a desc. Use vim.keymap.set (other APIs are not checked).
--
-- If you replace or shadow a shipped key, Neovim tells you once at startup;
-- :LokiKeys and :checkhealth loki list them. <leader>fk shows what a key does.
-- A key that is the start of a longer key (<leader>f vs <leader>ff) makes the
-- shorter one wait 'timeoutlen' (400 ms). Keys to think twice about: jk, <C-s>,
-- <C-h/j/k/l>, H, L, K, gd, gr, <Esc>, <C-\>, and <leader>f / w / c prefixes.

-- vim.keymap.set("n", "<leader>gg", "<cmd>Telescope git_status<cr>", { desc = "Git status" })

-- Move a shipped action to another key and free the old one:
-- vim.keymap.set("n", "<leader>fF", "<cmd>Telescope find_files<cr>", { desc = "Find files" })
-- vim.keymap.del("n", "<leader>ff")
